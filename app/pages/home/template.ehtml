import "./style.css";
import { FieldErrors, redirect, session, sql, tx, ValidationError } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemTitle } from "@elements/ui/item";

export interface RoomLink {
  id: string;
  code: string;
  name: string;
  people: number;
  facilitating: boolean;
}

interface NewRoom {
  roomName: string;
  yourName: string;
}

/** @rpc */
export function createRoom(form: NewRoom): string {
  let roomName = form.roomName.trim();
  let yourName = form.yourName.trim();

  let errors: FieldErrors<NewRoom> = {};
  if (roomName.length === 0) {
    errors.roomName = ["Give the room a name."];
  }

  if (yourName.length === 0) {
    errors.yourName = ["Tell the room who you are."];
  }

  if (Object.keys(errors).length > 0) {
    throw new ValidationError(errors);
  }

  return tx(() => {
    let userId = session.get("userId");

    // A session can outlive its user row; start a fresh identity rather than fail.
    if (userId && sql(`select 1 from users where id = ${userId}`).empty()) {
      userId = undefined;
    }

    if (!userId) {
      userId = sql<{ id: string }>(`insert into users (name) values (${yourName}) returning id`).firstOrThrow().id;
      session.login({ userId, userName: yourName });
    }

    let room = sql<{ id: string; code: string }>(`
      insert into rooms (name, facilitatorId)
           values (${roomName}, ${userId})
        returning id, code
    `).firstOrThrow();

    sql(`insert into participants (roomId, userId, name) values (${room.id}, ${userId}, ${yourName})`);

    return room.code;
  });
}

function onCreate(form: NewRoom): FieldErrors<NewRoom> {
  try {
    let code = createRoom(form);
    redirect(`/r/${code}`);
    return {};
  } catch (err: any) {
    if (err instanceof ValidationError) {
      return (err.errors ?? {}) as FieldErrors<NewRoom>;
    }

    throw err;
  }
}

<html lang="en" class="page-home" (
  myRooms: RoomLink[],
  demo: RoomLink | null,
  private form: NewRoom = { roomName: "", yourName: session.get("userName") ?? "" },
  private errors: FieldErrors<NewRoom> = {},
)>
  <head>
    <title>sizingdeck · planning poker</title>
    <meta name="description" content="Planning poker for sprint estimation. Create a room, share the link, estimate together.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="stack is-xl">
        <div class="home-intro row">
          <div class="stack is-sm">
            <h1>Estimate together</h1>
            <p class="lede">Open a room, share the link, and size the sprint in one sitting. Everyone picks a card face down; the facilitator flips them all at once.</p>
          </div>
          <div class="home-fan" aria-hidden="true">
            <span>3</span>
            <span>5</span>
            <span>8</span>
          </div>
        </div>

        <Card title="New room" level={2}>
          <CardContent>
            <form class="is-grid" onsubmit={() => errors = onCreate(form)}>
              <Field label="Room name" errors={errors.roomName ?? []}>
                <Input value={form.roomName} placeholder="Payments · Sprint 18" />
              </Field>

              <Field label="Your name" errors={errors.yourName ?? []}>
                <Input value={form.yourName} placeholder="Sam" />
              </Field>

              <div class="field is-full">
                <div class="row">
                  <Button type="submit" variant="primary">Create room</Button>
                </div>
                <p class="hint">You'll facilitate. Anyone with the link joins with just a name.</p>
              </div>
            </form>
          </CardContent>
        </Card>

        <Card e:if={demo} title="Demo room" level={2}>
          <CardContent>
            <Item>
              <ItemContent>
                <ItemTitle><a href={`/r/${demo!.code}`}>{demo!.name}</a></ItemTitle>
                <ItemDescription>{demo!.people} people at the table, with the sprint under way</ItemDescription>
              </ItemContent>
              <ItemActions><Button size="sm" href={`/r/${demo!.code}`}>Open</Button></ItemActions>
            </Item>
          </CardContent>
        </Card>

        <Card e:if={myRooms.length > 0} title="Your rooms" level={2}>
          <CardContent>
            <ItemGroup label="Your rooms">
              <Item e:for={room of myRooms}>
                <ItemContent>
                  <ItemTitle><a href={`/r/${room.code}`}>{room.name}</a></ItemTitle>
                  <ItemDescription>{room.people} {room.people === 1 ? "person" : "people"}</ItemDescription>
                </ItemContent>
                <ItemActions e:if={room.facilitating}><Badge variant="accent">Facilitator</Badge></ItemActions>
              </Item>
            </ItemGroup>
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>
