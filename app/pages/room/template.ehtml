import "./style.css";
import { LiveView } from "@elements/app";
import { Alert, AlertAction } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { ButtonGroup } from "@elements/ui/button-group";
import { Card, CardContent } from "@elements/ui/card";
import { BarChart } from "@elements/ui/chart-bar";
import type { ChartConfig } from "@elements/ui/chart";
import { Empty } from "@elements/ui/empty";
import { Field, FieldLegend, FieldSet } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { Item, ItemActions, ItemContent, ItemDescription, ItemFooter, ItemGroup, ItemMedia, ItemTitle } from "@elements/ui/item";
import { Progress } from "@elements/ui/progress";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { Participant, Room, Story, Vote } from "#app/shared/services/poker";
import { cardLabel, DECK, POINTS, spreadLabel, summarize, Summary } from "#app/shared/deck";
import {
  addStory,
  castVote,
  claimFacilitator,
  removeStory,
  reveal,
  revote,
  saveEstimate,
  startStory,
  StoryErrors,
  StoryForm,
} from "./services";

interface Mine {
  storyId: string;
  round: number;
  card: string;
}

const PLAYED: ChartConfig = {
  count: { label: "Cards", color: "var(--accent)" },
};

interface Notice {
  text: string;
}

function currentOf(room: Room | undefined, stories: LiveView<Story>): Story | undefined {
  if (!room?.currentStoryId) {
    return undefined;
  }

  return stories.get(room.currentStoryId);
}

function roundVotes(votes: LiveView<Vote>, story: Story | undefined): Vote[] {
  if (!story) {
    return [];
  }

  return votes.filter((v) => v.storyId === story.id && v.round === story.round);
}

function byJoined(people: LiveView<Participant>): Participant[] {
  return people.sort((a, b) => +a.createdAt - +b.createdAt || a.id.localeCompare(b.id));
}

function nameOf(people: LiveView<Participant>, userId: string | undefined): string {
  return people.find((p) => p.userId === userId)?.name ?? "the facilitator";
}

function myCard(mine: Mine, story: Story | undefined): string {
  if (!story || mine.storyId !== story.id || mine.round !== story.round) {
    return "";
  }

  return mine.card;
}

function linkLabel(url: string): string {
  try {
    let u = new URL(url);
    return (u.host + u.pathname).replace(/\/$/, "");
  } catch {
    return url;
  }
}

function fail(notice: Notice, err: any) {
  notice.text = err?.message ?? "Something went wrong. Try again.";
}

function onPick(roomId: string, story: Story, card: string, mine: Mine, notice: Notice) {
  if (story.status !== "voting") {
    return;
  }

  let before = { ...mine };
  let next = myCard(mine, story) === card ? null : card;

  mine.storyId = story.id;
  mine.round = story.round;
  mine.card = next ?? "";
  notice.text = "";

  try {
    castVote(roomId, story.id, next);
  } catch (err: any) {
    Object.assign(mine, before);
    fail(notice, err);
  }
}

function onReveal(roomId: string, notice: Notice) {
  notice.text = "";

  try {
    reveal(roomId);
  } catch (err: any) {
    fail(notice, err);
  }
}

function onRevote(roomId: string, notice: Notice) {
  notice.text = "";

  try {
    revote(roomId);
  } catch (err: any) {
    fail(notice, err);
  }
}

function onSave(roomId: string, estimate: string, notice: Notice) {
  notice.text = "";

  try {
    saveEstimate(roomId, estimate);
  } catch (err: any) {
    fail(notice, err);
  }
}

function onStart(roomId: string, storyId: string, notice: Notice) {
  notice.text = "";

  try {
    startStory(roomId, storyId);
  } catch (err: any) {
    fail(notice, err);
  }
}

function onRemove(roomId: string, storyId: string, notice: Notice) {
  notice.text = "";

  try {
    removeStory(roomId, storyId);
  } catch (err: any) {
    fail(notice, err);
  }
}

function onClaim(roomId: string, notice: Notice) {
  notice.text = "";

  try {
    claimFacilitator(roomId);
  } catch (err: any) {
    fail(notice, err);
  }
}

function onAddStory(roomId: string, form: StoryForm, notice: Notice): StoryErrors {
  notice.text = "";

  try {
    addStory(roomId, form);
    form.title = "";
    form.url = "";
    return {};
  } catch (err: any) {
    if (err?.errors) {
      return err.errors as StoryErrors;
    }

    fail(notice, err);
    return {};
  }
}

async function onCopy(url: string, state: { copied: boolean }) {
  await navigator.clipboard.writeText(url);
  state.copied = true;
  setTimeout(() => state.copied = false, 1800);
}

<html lang="en" class="page-room" (
  roomRows: LiveView<Room>,
  people: LiveView<Participant>,
  stories: LiveView<Story>,
  votes: LiveView<Vote>,
  me: string,
  mine: Mine,
  shareUrl: string,
  private notice: Notice = { text: "" },
)>
  <head>
    <title>{roomRows.at(0)?.name ?? "Room"} · sizingdeck</title>
    <meta name="description" content="A planning poker room on sizingdeck.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout wide={true}>
      <div class="stack is-xl">
        <RoomHead room={roomRows.at(0)!} {people} {me} {shareUrl} {notice} />

        <Alert e:if={notice.text} variant="danger" description={notice.text}>
          <AlertAction><Button variant="ghost" size="sm" onclick={() => notice.text = ""}>Dismiss</Button></AlertAction>
        </Alert>

        <div class="room-grid">
          <div class="stack is-lg">
            <Stage
              room={roomRows.at(0)!}
              story={currentOf(roomRows.at(0), stories)}
              {stories}
              {people}
              cast={roundVotes(votes, currentOf(roomRows.at(0), stories))}
              {me}
              {mine}
              {notice}
            />
          </div>

          <div class="stack is-lg">
            <Queue
              room={roomRows.at(0)!}
              pending={stories.filter((s) => s.status === "pending").sort((a, b) => +a.createdAt - +b.createdAt)}
              {me}
              {notice}
            />
            <Estimated
              room={roomRows.at(0)!}
              done={stories.filter((s) => s.status === "estimated").sort((a, b) => +(b.estimatedAt ?? 0) - +(a.estimatedAt ?? 0))}
            />
          </div>
        </div>
      </div>
    </Layout>
  </body>
</html>

<RoomHead (
  room: Room,
  people: LiveView<Participant>,
  me: string,
  shareUrl: string,
  notice: Notice,
  private share: { copied: boolean } = { copied: false },
)>
  <div class="room-head stack">
    <h1>{room.name}</h1>
    <div class="room-meta cluster">
      <ButtonGroup class="room-share" label="Room link">
        <Input readonly value={shareUrl} size="sm" attrs={{ "aria-label": "Room link" }} onfocus={(e: FocusEvent) => (e.target as HTMLInputElement).select()} />
        <Button size="sm" onclick={() => onCopy(shareUrl, share)}>{share.copied ? "Copied" : "Copy link"}</Button>
      </ButtonGroup>
      <Badge e:if={room.facilitatorId === me} variant="accent">You're facilitating</Badge>
      <span e:else class="cluster is-sm">
        <span>Facilitator: <strong>{nameOf(people, room.facilitatorId)}</strong></span>
        <Button variant="link" size="sm" onclick={() => onClaim(room.id, notice)}>Take over</Button>
      </span>
      <span>{people.length} at the table</span>
    </div>
  </div>
</RoomHead>

<Stage (
  room: Room,
  story: Story | undefined,
  stories: LiveView<Story>,
  people: LiveView<Participant>,
  cast: Vote[],
  me: string,
  mine: Mine,
  notice: Notice,
  private facilitating: boolean = room.facilitatorId === me,
)>
  <Card>
    <CardContent class="stack is-lg" e:if={story}>
      <div class="stage-title row">
        <div class="stack is-xs">
          <p class="eyebrow">{story!.status === "revealed" ? "Cards are up" : "Now estimating"}</p>
          <h2>{story!.title}</h2>
          <a e:if={story!.url} class="stage-link" href={story!.url} target="_blank" rel="noopener">{linkLabel(story!.url)}</a>
        </div>
        <div class="stage-actions row" e:if={facilitating}>
          <Button e:if={cast.length > 0 || story!.status === "revealed"} onclick={() => onRevote(room.id, notice)}>
            {story!.status === "revealed" ? "Vote again" : "Clear cards"}
          </Button>
          <Button variant="primary" e:if={story!.status === "voting"} disabled={cast.length === 0} onclick={() => onReveal(room.id, notice)}>
            Reveal cards
          </Button>
        </div>
      </div>

      <TableSeats {story} {people} {cast} {room} {me} />

      <Results e:if={story!.status === "revealed"} {room} story={story!} {cast} {facilitating} {people} {notice} />
    </CardContent>

    <CardContent e:elseif={stories.some((s) => s.status === "pending")}>
      <Empty
        title="Pick the next story"
        description={facilitating ? "Choose one from Up next to start the vote." : `Waiting for ${nameOf(people, room.facilitatorId)} to pick the next story.`}
      />
    </CardContent>

    <CardContent e:elseif={stories.length > 0}>
      <Empty
        title="Everything's sized"
        description={`${stories.length} ${stories.length === 1 ? "story" : "stories"} estimated. Add more to keep going, or export the list.`}
      />
    </CardContent>

    <CardContent e:else>
      <Empty
        title="No stories yet"
        description={facilitating ? "Add the first story on the right and voting starts right away." : `Waiting for ${nameOf(people, room.facilitatorId)} to add a story.`}
      />
    </CardContent>
  </Card>

  <Hand e:if={story} room={room} story={story!} {mine} {notice} />
</Stage>

<TableSeats (
  story: Story | undefined,
  people: LiveView<Participant>,
  cast: Vote[],
  room: Room,
  me: string,
)>
  <div class="table">
    <ul class="seats">
      <li class="seat" e:for={[i, p] of byJoined(people).entries()} e:key={([i, p]) => p.id}>
        <Seat person={p} vote={cast.find((v) => v.userId === p.userId)} index={i} {room} {me} {cast} />
      </li>
    </ul>

    <div class="table-status row" e:if={story?.status === "voting"}>
      <Progress value={cast.length} max={people.length} size="sm" getValueLabel={(v, max) => `${v} of ${max} voted`} attrs={{ "aria-label": "Votes cast" }} />
      <span>{cast.length} of {people.length} voted</span>
    </div>
  </div>
</TableSeats>

<Seat (
  person: Participant,
  vote: Vote | undefined,
  index: number,
  room: Room,
  me: string,
  cast: Vote[],
)>
  <div
    class={[
      "pcard",
      vote && "has-vote",
      vote?.revealed && "is-revealed",
      vote?.revealed && isOutlier(vote, cast) && "is-outlier",
    ]}
    style={{ "--i": String(index) }}
    aria-label={vote ? (vote.revealed ? `${person.name} played ${cardLabel(vote.card ?? "")}` : `${person.name} has voted`) : `${person.name} has not voted`}
  >
    <div class="pcard-inner">
      <div class="pcard-slot">…</div>
      <div class="pcard-back"></div>
      <div class="pcard-face">{vote?.card ? cardLabel(vote.card) : ""}</div>
    </div>
  </div>
  <span class="seat-name">{person.name}</span>
  <span class="seat-role" e:if={person.userId === room.facilitatorId}>facilitator{person.userId === me ? " · you" : ""}</span>
  <span class="seat-role" e:elseif={person.userId === me}>you</span>
</Seat>

<Results (
  room: Room,
  story: Story,
  cast: Vote[],
  facilitating: boolean,
  people: LiveView<Participant>,
  notice: Notice,
  private summary: Summary = summarize(cast.map((v) => v.card ?? "")),
  private pick: { key: string; value: string } = { key: "", value: "" },
)>
  <div class="stack is-lg">
    <div class="results">
      <div class="results-average">
        <div class="results-number">{summary.average ?? "–"}</div>
        <div class="results-label">Average</div>
      </div>

      <div class="stack is-sm">
        <div class="cluster is-sm">
          <Badge variant={summary.consensus ? "success" : summary.steps >= 3 ? "warning" : "info"} dot>
            {summary.numericCount > 0 ? spreadLabel(summary) : "No point cards"}
          </Badge>
          <span class="hand-hint" e:if={summary.numericCount > 0 && !summary.consensus}>
            Spread {summary.low} to {summary.high}, {summary.steps} {summary.steps === 1 ? "step" : "steps"} apart
          </span>
        </div>

        <p class="results-talk" e:if={summary.steps >= 2}>
          <strong>{playersOf(cast, people, summary.low!)}</strong> played {summary.low} and <strong>{playersOf(cast, people, summary.high!)}</strong> played {summary.high}. Hear them out before settling.
        </p>

        <BarChart
          data={summary.counts.map((c) => ({ card: cardLabel(c.card), count: c.count }))}
          config={PLAYED}
          x="card"
          orientation="horizontal"
          labels={{ position: "right" }}
          valueAxis={false}
          grid={false}
          tooltip={false}
          background
          barSize={10}
          label="Cards played"
          class="results-bars"
          attrs={{ style: `--rows: ${summary.counts.length}` }}
        />
      </div>
    </div>

    <FieldSet e:if={facilitating} class="settle">
      <FieldLegend variant="label">Final estimate</FieldLegend>
      <ToggleGroup
        type="single"
        variant="outline"
        size="sm"
        label="Final estimate"
        value={chosen(pick, story, summary)}
        onValueChange={(v, details) => v ? pick = { key: pickKey(story), value: v } : details.cancel()}
      >
        <ToggleGroupItem e:for={p of POINTS} e:key={(p) => p} value={p}>{p}</ToggleGroupItem>
      </ToggleGroup>
      <div class="row">
        <Button variant="primary" disabled={chosen(pick, story, summary) === ""} onclick={() => onSave(room.id, chosen(pick, story, summary), notice)}>
          Save {chosen(pick, story, summary) ? `${chosen(pick, story, summary)} points` : "estimate"}
        </Button>
      </div>
    </FieldSet>

    <p class="hand-hint" e:else>
      {nameOf(people, room.facilitatorId)} will settle the final estimate{summary.suggestion ? `; the cards point to ${summary.suggestion}` : ""}.
    </p>
  </div>
</Results>

<Hand (
  room: Room,
  story: Story,
  mine: Mine,
  notice: Notice,
)>
  <Card>
    <CardContent class="stack">
      <div class="hand" role="group" aria-label="Your cards">
        <button
          e:for={card of DECK}
          e:key={(card) => card}
          class={["hand-card", myCard(mine, story) === card && "is-active"]}
          aria-pressed={myCard(mine, story) === card ? "true" : "false"}
          aria-label={card === "coffee" ? "Coffee break" : card === "?" ? "Not sure" : `${card} points`}
          disabled={story.status !== "voting"}
          onclick={() => onPick(room.id, story, card, mine, notice)}
        >{cardLabel(card)}</button>
      </div>
      <p class="hand-hint" e:if={story.status !== "voting"}>Cards are up. Wait for the final estimate or a new round.</p>
      <p class="hand-hint" e:elseif={myCard(mine, story)}>Your card is down. Nobody sees it until the reveal; pick again to change it.</p>
      <p class="hand-hint" e:else>Pick a card. It stays face down until the facilitator reveals.</p>
    </CardContent>
  </Card>
</Hand>

<Queue (
  room: Room,
  pending: Story[],
  me: string,
  notice: Notice,
  private facilitating: boolean = room.facilitatorId === me,
  private form: StoryForm = { title: "", url: "" },
  private errors: StoryErrors = {},
)>
  <Card title="Up next" level={2}>
    <CardContent class="stack">
      <ItemGroup e:if={pending.length > 0} label="Up next">
        <Item size="sm" e:for={s of pending}>
          <ItemContent>
            <ItemTitle>{s.title}</ItemTitle>
          </ItemContent>
          <ItemActions e:if={facilitating}>
            <Button size="sm" onclick={() => onStart(room.id, s.id, notice)}>Estimate</Button>
            <Button variant="ghost" size="sm" icon label={`Remove ${s.title}`} onclick={() => onRemove(room.id, s.id, notice)}><Icon name="x" /></Button>
          </ItemActions>
          <ItemFooter e:if={s.url}>
            <a class="story-link" href={s.url} target="_blank" rel="noopener">{linkLabel(s.url)}</a>
          </ItemFooter>
        </Item>
      </ItemGroup>
      <Empty e:else description={facilitating ? "Nothing queued. Add a story below." : "Nothing queued yet."} />

      <form class="stack is-sm" e:if={facilitating} onsubmit={() => errors = onAddStory(room.id, form, notice)}>
        <Field label="Story" errors={errors.title ?? []}>
          <Input value={form.title} placeholder="Export invoices as PDF" />
        </Field>
        <Field label="Link" errors={errors.url ?? []}>
          <Input value={form.url} placeholder="https://tracker.example.com/PAY-204" />
        </Field>
        <Button type="submit" block>Add story</Button>
      </form>
      <Empty e:else description="The facilitator adds the stories." />
    </CardContent>
  </Card>
</Queue>

<Estimated (room: Room, done: Story[])>
  <Card title="Estimated" level={2}>
    <CardContent class="stack">
      <ItemGroup e:if={done.length > 0} label="Estimated">
        <Item size="sm" e:for={s of done}>
          <ItemMedia><span class="done-chip">{s.estimate}</span></ItemMedia>
          <ItemContent>
            <ItemTitle>
              <a e:if={s.url} href={s.url} target="_blank" rel="noopener">{s.title}</a>
              <span e:else>{s.title}</span>
            </ItemTitle>
            <ItemDescription>avg {s.average ?? "–"} · {s.voteCount} {s.voteCount === 1 ? "vote" : "votes"}</ItemDescription>
          </ItemContent>
        </Item>
      </ItemGroup>
      <Empty e:else description="Settled stories collect here." />

      <div class="done-total row" e:if={done.length > 0}>
        <span><strong>{done.reduce((sum, s) => sum + Number(s.estimate ?? 0), 0)}</strong> points across {done.length} {done.length === 1 ? "story" : "stories"}</span>
        <Button size="sm" href={`/r/${room.code}/estimates.csv`} attrs={{ download: true }}>Export CSV</Button>
      </div>
    </CardContent>
  </Card>
</Estimated>

function isOutlier(vote: Vote, cast: Vote[]): boolean {
  let s = summarize(cast.map((v) => v.card ?? ""));
  if (s.steps < 2 || !vote.card || !POINTS.includes(vote.card)) {
    return false;
  }

  return vote.card === s.low || vote.card === s.high;
}

function playersOf(cast: Vote[], people: LiveView<Participant>, card: string): string {
  let names = cast.filter((v) => v.card === card).map((v) => nameOf(people, v.userId).split(" ")[0]);
  if (names.length <= 2) {
    return names.join(" and ");
  }

  return `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]}`;
}

function pickKey(story: Story): string {
  return `${story.id}:${story.round}`;
}

function chosen(pick: { key: string; value: string }, story: Story, summary: Summary): string {
  return pick.key === pickKey(story) ? pick.value : summary.suggestion ?? "";
}
